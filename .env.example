DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_URL=admin/

# Local run against the db container; inside compose it is overridden to host "db"
DATABASE_URL=postgres://railcompas:railcompas@127.0.0.1:5433/railcompas

# Comma-separated, scheme://user:pass@host:port
SCRAPER_PROXIES=
SCRAPER_HEADLESS=true

# Background refresh of scheduled routes (true on the server)
SCHEDULER_ENABLED=false
